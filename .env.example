# RestoCopilot AI - Environment Template
# Duplicate this file as '.env' and fill in your credentials.

# 1. Dual Engine Mode Configuration:
# - OFFLINE (OFF): Local Fast Llama Model (Zero token cost, runs offline, zero data leak)
# - ONLINE (ON): Gemma Open-Weights Engine (Deep culinary reasoning & complex dispute resolution)
AMD_VLLM_ENDPOINT=https://developer.amd.com.cn/radeon/api/v1
AMD_VLLM_API_KEY=your_amd_vllm_api_key_here
ONLINE_MODEL_NAME=Gemma-4-31B-IT
OFFLINE_MODEL_NAME=Llama-3.2-Light

# 2. Voice Callout API (Optional: Leave blank for gTTS offline speech fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# 3. SerpApi Google Maps Reviews Integration Key
SERPAPI_API_KEY=your_serpapi_key_here

# 4. SMS Dispatch Gateway Configuration (Choose: TWILIO, SMSINDIAHUB, or FAST2SMS)
SMS_PROVIDER=TWILIO

# Twilio Telecom Gateway Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# SMSIndiaHub / Fast2SMS (Optional alternative gateways)
SMSINDIAHUB_API_KEY=
SMSINDIAHUB_SENDER_ID=SMSTXT
FAST2SMS_API_KEY=
